{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/dashboard/**",
              "components/navigation/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='ring'] > Literal[value!=/^(?:none|light|brand)$/]",
        "message": "<Avatar> ring must be one of 'none' | 'light' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|shape|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, shape, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|brand|neutral)$/]",
        "message": "<Badge> tone must be one of 'success' | 'warning' | 'danger' | 'brand' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:chip|pill|count)$/]",
        "message": "<Badge> shape must be one of 'chip' | 'pill' | 'count'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, fullWidth, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|title|action|padding|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, title, action, padding, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand|dark|sunken)$/]",
        "message": "<Card> tone must be one of 'default' | 'brand' | 'dark' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, tone, size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|sunken|outline|onBrand|brand|danger)$/]",
        "message": "<IconButton> tone must be one of 'plain' | 'sunken' | 'outline' | 'onBrand' | 'brand' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|count|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, active, count, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|size|thickness|style|key|ref|className|style|children)$/]",
        "message": "<ProgressGauge> doesn't accept that prop. Declared props: value, label, size, thickness, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconTone|title|meta|right|onClick|key|ref|className|style|children)$/]",
        "message": "<ProjectListItem> doesn't accept that prop. Declared props: icon, iconTone, title, meta, right, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectListItem'] > JSXAttribute[name.name='iconTone'] > Literal[value!=/^(?:brand|honey|olive|plum|neutral)$/]",
        "message": "<ProjectListItem> iconTone must be one of 'brand' | 'honey' | 'olive' | 'plum' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<PromoCard> doesn't accept that prop. Declared props: icon, title, body, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReminderCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|time|actionLabel|actionIcon|onAction|style|key|ref|className|style|children)$/]",
        "message": "<ReminderCard> doesn't accept that prop. Declared props: title, time, actionLabel, actionIcon, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|shortcut|width|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, shortcut, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|key|ref|className|style|children)$/]",
        "message": "<SidebarSection> doesn't accept that prop. Declared props: label, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|trend|highlight|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, note, trend, highlight, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down|none)$/]",
        "message": "<StatCard> trend must be one of 'up' | 'down' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamMemberRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|workingOn|status|prefix|key|ref|className|style|children)$/]",
        "message": "<TeamMemberRow> doesn't accept that prop. Declared props: name, src, workingOn, status, prefix."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamMemberRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:Completed|In Progress|Pending|Blocked)$/]",
        "message": "<TeamMemberRow> status must be one of 'Completed' | 'In Progress' | 'Pending' | 'Blocked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeTracker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|seconds|running|onToggle|onStop|style|key|ref|className|style|children)$/]",
        "message": "<TimeTracker> doesn't accept that prop. Declared props: label, seconds, running, onToggle, onStop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:query|onQueryChange|user|actions|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: query, onQueryChange, user, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeeklyBarDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|active|tooltip|key|ref|className|style|children)$/]",
        "message": "<WeeklyBarDatum> doesn't accept that prop. Declared props: label, value, active, tooltip."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
